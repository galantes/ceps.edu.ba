Options -Indexes -MultiViews
DirectoryIndex index.php
RewriteEngine On
# Configuration, source, database export and logs stay inside a protected folder.
RewriteRule ^app(?:/|$) - [F,L,NC]
<FilesMatch "(?i)^(?:config\.local\.php|UPUTE\.txt)$|\.(?:sql|log|ini|env|bak)$">
    Require all denied
</FilesMatch>
# Route legacy language hosts through the application for URL-specific 301 redirects.
RewriteCond %{HTTP_HOST} ^(?:en|de)\.ceps\.edu\.ba$ [NC]
RewriteRule ^ index.php [L]
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^www\.ceps\.edu\.ba$ [NC]
RewriteRule ^ https://ceps.edu.ba%{REQUEST_URI} [R=301,L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [QSA,L]
